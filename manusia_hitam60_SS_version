                local attachment = Instance.new("Attachment", head)
                attachment.Name = "MH60_Attachment"
                local emitter = Instance.new("ParticleEmitter", attachment)
                emitter.Texture = ID_Part emitter.Rate = 10000 emitter.Lifetime = NumberRange.new(20)
                emitter.Speed = NumberRange.new(150) emitter.Size = NumberSequence.new(10) 
                emitter.SpreadAngle = Vector2.new(45, 45) emitter.EmissionDirection = Enum.NormalId.Top
                emitter.Acceleration = Vector3.new(0, 3, 0)
            end
            setup(player.Character) player.CharacterAdded:Connect(setup)
        end
        for _, v in pairs(Players:GetPlayers()) do applyParticleEffect(v) end
        Players.PlayerAdded:Connect(applyParticleEffect)
    end)
    
